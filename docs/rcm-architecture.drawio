        <mxCell id="legr" value="runtime traffic  (HTTPS  →  Caddy  →  Rathole tunnel  →  home app)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#82b366;" vertex="1" parent="leg">
          <mxGeometry x="40" y="62" width="260" height="20" as="geometry" />
